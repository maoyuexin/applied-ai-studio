# Design Studio connects to YOUR Microsoft Foundry / Azure resources. Copy to .env and fill in.
# Auth is Microsoft Entra ID: `az login` on a laptop, or AZURE_CLIENT_ID / AZURE_TENANT_ID /
# AZURE_CLIENT_SECRET for a service principal on a server. No API keys are used or stored.
# Each identity needs the "Cognitive Services User" role on the resources below.

DESIGN_INSTALL_NAME=Local
# DESIGN_DATA_DIR=/path/to/design-data          # default: ~/Library/Application Support/AppliedAIStudio/design (macOS)
# DESIGN_PROVIDER_MODE=fake                     # offline demo with placeholder media, no Azure needed

# Text roles: OpenAI v1 endpoint of a Foundry / Azure OpenAI resource
DESIGN_TEXT_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1
DESIGN_TEXT_DRAFT_DEPLOYMENT=gpt-5.4-mini
DESIGN_TEXT_JUDGE_DEPLOYMENT=gpt-5.4
# Other deployments a run may pick on the New run page (comma separated)
DESIGN_TEXT_MODELS=gpt-5.4-mini,gpt-5.4

# Image role: MAI-Image deployment (base URL of the Foundry resource)
DESIGN_IMAGE_ENDPOINT=https://<your-resource>.services.ai.azure.com
DESIGN_IMAGE_DEPLOYMENT=mai-image-2-6
DESIGN_IMAGE_MODEL_LABEL=MAI-Image-2.6
DESIGN_IMAGE_PER_MINUTE=6

# Video role: Sora deployment (OpenAI v1 Videos API)
DESIGN_VIDEO_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1
DESIGN_VIDEO_DEPLOYMENT=sora-2
DESIGN_VIDEO_MODEL_VERSION=2025-12-08
DESIGN_VIDEO_RETIRES_ON=2026-10-15

# Voice + listen-back roles: Azure Speech on a Foundry / AI Services resource (region + resource id)
DESIGN_SPEECH_REGION=eastus2
DESIGN_SPEECH_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<your-resource>
DESIGN_VOICE_MODEL=MAI-Voice-2.1-Flash

# Daily caps (protect your subscription; Settings shows usage)
DESIGN_CAP_VIDEO_TAKES=20
DESIGN_CAP_IMAGES=60
DESIGN_CAP_VOICE_LINES=200
DESIGN_CAP_TEXT_CALLS=500
