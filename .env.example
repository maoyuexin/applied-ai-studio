# Local service ports used by the npm fallback launcher.
CATALOG_PORT=4310
AGENT_PORT=4320
WEB_PORT=5173
MEDIA_API_PORT=4420

# GitHub Copilot SDK uses the signed-in Copilot CLI user by default.
COPILOT_MODEL=auto
COPILOT_LOG_LEVEL=warning
CHAT_TIMEOUT_MS=60000

# The agent service reads facts only through this API boundary.
CATALOG_API_URL=http://127.0.0.1:4310

# Promo Studio live generation is opt-in. Leave off for recorded classroom mode.
MEDIA_LIVE_IMAGES=0
MEDIA_LIVE_VIDEO=0
MEDIA_DAILY_IMAGE_CAP=40
MEDIA_DAILY_VIDEO_CAP=4
MEDIA_IMAGE_RETRY_ATTEMPTS=3
MEDIA_IMAGE_RETRY_BACKOFF_SECONDS=1