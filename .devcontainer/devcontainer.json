{
  "name": "Applied AI Studio",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  // Every feature is a download from ghcr.io at create time, and each one is a way the
  // build can fail. The GitHub CLI was here for convenience and nothing in this app uses
  // it, so it is gone - two dependencies instead of three.
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/python:1": { "version": "3.11" }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "waitFor": "postCreateCommand",

  "forwardPorts": [5173, 4310, 4320, 4330, 4340],
  "portsAttributes": {
    "5173": { "label": "Applied AI Studio", "onAutoForward": "openBrowserOnce" },
    "4310": { "label": "Catalog API", "onAutoForward": "silent" },
    "4320": { "label": "Copilot agent API", "onAutoForward": "silent" },
    "4330": { "label": "Online Order API", "onAutoForward": "silent" },
    "4340": { "label": "Fraud Detection API", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  },

  "hostRequirements": { "cpus": 2, "memory": "8gb", "storage": "32gb" }
}
